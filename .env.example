# =========================================================================
# CAIAS SMART ATTENDANCE MANAGEMENT PLATFORM — ENVIRONMENT CONFIGURATION
# =========================================================================

# Database Configuration:
# For zero-config local development, use SQLite:
DATABASE_URL="file:./dev.db"

# For Hosted PostgreSQL (Supabase, Neon, AWS RDS, Railway) in production:
# DATABASE_URL="postgresql://postgres:[PASSWORD]@[HOST]:5432/[DBNAME]?sslmode=require"

# Cryptographic Authentication Key (minimum 256-bit random secret)
JWT_SECRET="replace-with-a-secure-256-bit-key-in-production"

# Application Settings
NEXT_PUBLIC_APP_NAME="CAIAS Smart Attendance Platform"
NEXT_PUBLIC_API_URL="http://127.0.0.1:8000/api"

# AI Face Verification Microservice (Python FastAPI)
FASTAPI_AI_URL="http://127.0.0.1:8000"

# Optional Email Notification Provider (Gracefully ignored if left blank)
SMTP_HOST=""
SMTP_PORT="587"
SMTP_USER=""
SMTP_PASS=""
