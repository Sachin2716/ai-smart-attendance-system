# =========================================================================
# SMARTFACE ATTENDANCE MANAGEMENT SYSTEM — ENVIRONMENT CONFIGURATION
# =========================================================================

# Fast API Backend Configuration
PROJECT_NAME="SmartFace Attendance Management System"
VERSION="1.0.0"
SECRET_KEY="replace-with-a-secure-random-256-bit-key-in-production"
ALGORITHM="HS256"
ACCESS_TOKEN_EXPIRE_MINUTES=1440

# Database Configuration
# For local development with SQLite fallback (runs out of the box):
DATABASE_URL="sqlite:///./smartface.db"

# For Supabase PostgreSQL (production or cloud):
# DATABASE_URL="postgresql://postgres:[YOUR-PASSWORD]@db.[YOUR-PROJECT-REF].supabase.co:5432/postgres"

# Supabase API Credentials (Optional / for client-side direct calls)
# NEXT_PUBLIC_SUPABASE_URL="https://[YOUR-PROJECT-REF].supabase.co"
# NEXT_PUBLIC_SUPABASE_ANON_KEY="[YOUR-ANON-KEY]"

# Face Recognition AI Engine Parameters
SIMILARITY_THRESHOLD=0.78
LIVENESS_THRESHOLD=0.65
BLUR_MIN_VARIANCE=50.0
BRIGHTNESS_MIN=30.0
BRIGHTNESS_MAX=230.0

# CORS Allowed Origins
CORS_ORIGINS='["http://localhost:3000", "http://localhost:5173", "http://127.0.0.1:3000", "http://127.0.0.1:5173"]'
